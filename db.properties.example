# Copiez ce fichier en "db.properties" (même dossier) puis renseignez vos identifiants.
# db.properties est ignoré par Git : vos mots de passe ne sont jamais publiés.

# Oracle XE 18c / 21c (ou conteneur Docker fourni) : service XEPDB1
db.url=jdbc:oracle:thin:@//localhost:1521/XEPDB1
# Oracle XE 11g : utilisez plutôt le SID XE
# db.url=jdbc:oracle:thin:@localhost:1521:XE

db.user=edumanager
db.password=edumanager
